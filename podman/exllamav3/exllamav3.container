[Unit]
Description=ExLlamaV3 inference server (TabbyAPI, OpenAI-compatible)

[Container]
Image=ghcr.io/theroyallab/tabbyapi:cu13
ContainerName=exllamav3
# Entrypoint is python3; command args map to main.py flags
Exec=main.py --host 0.0.0.0 --port 5000 --model-dir /app/models --model-name qwen3.8-27b-exl3 --max-seq-len 179968
PublishPort:8090:5000
# Staged model directory (deref'ed COW copies of the HF snapshots;
# see scripts/utils/sync_model.sh). HF cache symlinks don't survive a
# snapshot-only bind mount, so we stage real directories instead.
Volume=/srv/models/exllamav3:/app/models:ro
# Pipe through RTX 5090
AddDevice=nvidia.com/gpu=0
# ExLlamaV3 uses /dev/shm for TP handoff buffers + CPU MoE offload;
# the default 64MiB is not enough
ShmSize=8g
