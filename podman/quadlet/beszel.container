[Unit]
Description=Beszel Hub
After=network-online.target

[Container]
Image=docker.io/henrygd/beszel:latest
ContainerName=beszel
Network=proxy.network
Environment=TZ=Australia/Brisbane
Environment=APP_URL=http://homelab/beszel
Volume=%h/beszel/beszel_data:/beszel_data:Z
Volume=%h/beszel/beszel_socket:/beszel_socket:Z

[Service]
Restart=unless-stopped

[Install]
WantedBy=default.target
