# ai-5080 stack: how it starts, endpoints, VRAM -> podman/ai-5080/README.md
[Unit]
Description=Qwen3-ASR-1.7B speech to text (vLLM, RTX 5080)
After=network-online.target
# A crash-looping engine is a power-spike loop: give up after 3 tries in 15 min
StartLimitIntervalSec=900
StartLimitBurst=3

[Container]
Image=docker.io/vllm/vllm-openai:latest
ContainerName=asr
Network=inference
PublishPort=8101:8000

# Only the hub cache, read-only: HF_HOME (/srv/models) also holds the HF token
Volume=/srv/models/hub:/root/.cache/huggingface/hub:ro
Environment=HF_HUB_OFFLINE=1

# RTX 5080 only, by UUID: the 5090 belongs to strata/vllm/ninfer/unsloth
PodmanArgs=--device=nvidia.com/gpu=GPU-e4668f97-25e5-867c-92c5-4de87f529c42
Environment=NVIDIA_VISIBLE_DEVICES=GPU-e4668f97-25e5-867c-92c5-4de87f529c42
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility

DropCapability=ALL
NoNewPrivileges=true

# The four 5080 services share 16 GB: this one gets 45% (~7.3 GB). 0.35 does not
# start: after 3.9 GiB of weights, the encoder cache and CUDA graphs, only 0.14 GiB
# is left for KV cache (one 8192-token request needs 0.88 GiB).
Exec=--model Qwen/Qwen3-ASR-1.7B \
  --served-model-name qwen3-asr \
  --gpu-memory-utilization 0.45 \
  --max-model-len 8192 \
  --max-num-seqs 16

# The next service in ai-5080.target waits for this to pass (Notify=healthy)
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
HealthInterval=10s
HealthStartPeriod=10m
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure
RestartSec=60
TimeoutStartSec=900
