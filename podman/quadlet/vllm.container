[Unit]
Description=Vllm Inference Engine
After=network-online.target

[Container]
Image=docker.io/vllm/vllm-openai:cu134-nightly
ContainerName=vllm
Network=inference
PublishPort=8001:8000
Volume=/srv/models/:/root/.cache/huggingface:ro,z

PodmanArgs=--device=nvidia.com/gpu=0

Environment=NVIDIA_VISIBLE_DEVICES=0
Environment=VLLM_USE_RUST_FRONTEND=1
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility

Exec=--model Inferact/Qwen3.8-27B-NVFP4 --tensor-parallel-size 1 --enable-auto-tool-choice --tool-call-parser qwen3_xml  --reasoning-parser qwen3 --mm-encoder-tp-mode data --gpu-memory-utilization 0.85 --max-model-len 32768

[Service]
TimeoutStartSec=900
