[Unit]
Description=Unsloth AI Container
After=network-online.target

[Container]
Image=docker.io/unsloth/unsloth:latest
ContainerName=unsloth
PublishPort=8000:8000
PublishPort=8888:8888
Network=inference

PodmanArgs=--ipc=host
# RTX 5090 only, by UUID: the 5080 is reserved for the ai-5080 speech/embedding stack
PodmanArgs=--device=nvidia.com/gpu=GPU-cbd73127-475d-a971-3a16-f47d7453f0ac
Environment=NVIDIA_VISIBLE_DEVICES=GPU-cbd73127-475d-a971-3a16-f47d7453f0ac

SecurityLabelDisable=true
Volume=%h/unsloth-workspace:/workspace/host:Z
# Only the hub cache: /srv/models is HF_HOME and holds the Hugging Face token.
# The rest of HF_HOME (datasets, xet cache) persists in a volume.
Volume=unsloth-hf:/workspace/.cache/huggingface
Volume=/srv/models/hub:/workspace/.cache/huggingface/hub:Z
# For gated models or pushing to the Hub:
#   printf %s "$(cat /srv/models/token)" | podman secret create hf_token -
# Secret=hf_token,type=env,target=HF_TOKEN
Volume=unsloth-studio:/opt/unsloth-studio

[Service]
Restart=always
TimeoutStartSec=900

# Not started at boot: training only, start by hand (systemctl --user start unsloth)
