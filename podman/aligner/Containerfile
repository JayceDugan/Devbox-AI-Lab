# Qwen3-ForcedAligner-0.6B-hf behind a small HTTP API (POST /align).
# Uses the native Transformers implementation (>= 5.13), not the qwen-asr package,
# which pins transformers 4.57.6. Weights come read-only from the HF cache at runtime.
FROM docker.io/library/python:3.12-slim

# libsndfile for soundfile, ffmpeg so uploads in any container format decode
RUN apt-get update \
 && apt-get install -y --no-install-recommends libsndfile1 ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# cu132 wheels: the host driver supports CUDA 13.4, and they include sm_120 (RTX 50xx)
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu132 \
      torch==2.14.1 \
 && pip install --no-cache-dir \
      transformers==5.19.0 accelerate==1.15.0 \
      fastapi==0.143.0 uvicorn==0.54.0 python-multipart==0.0.32 \
      soundfile==0.14.0 librosa==1.0.0

RUN useradd --create-home --uid 1001 app
WORKDIR /app
COPY server.py .
USER app

# Only the hub cache is mounted (at /hub), never HF_HOME: that holds the HF token
ENV HF_HUB_CACHE=/hub HF_HOME=/tmp/hf HF_HUB_OFFLINE=1 PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10m --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
