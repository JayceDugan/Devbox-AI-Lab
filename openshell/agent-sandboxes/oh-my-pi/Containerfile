# Pi Coding Agent sandbox image for OpenShell
#
# Builds on the community base sandbox and adds pi.
#
# Build:  docker build -t openshell-pi --build-arg BASE_IMAGE=openshell-base .
# Run:    openshell sandbox create --from pi
ARG BASE_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest
FROM ${BASE_IMAGE}

LABEL maintainer="Jayce Dugan" \
      description="Openshell Sandbox Oh My Pi coding agent" \
      version="0.1"

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

USER sandbox

# Copy sandbox policy
COPY policy.yaml /etc/openshell/policy.yaml

WORKDIR /sandbox

USER sandbox

# Add omp install directory to PATH
RUN echo 'export PATH="$PATH:/sandbox/.local/bin"' >> /sandbox/.bashrc
ENV PATH="/sandbox/.local/bin:${PATH}"

RUN curl -fsSL https://omp.sh/install | sh

# Configure pi to use the OpenShell local inference endpoint (https://inference.local)
COPY --chown=sandbox:sandbox agent-config/ /sandbox/.omp

ENTRYPOINT ["omp", "--allow-home"]
