# Pi Coding Agent — PR REVIEW sandbox image for OpenShell
#
# Builds on the community base sandbox and adds pi, file-search tools, and
# git-over-https auth via gh's built-in credential helper. The read-only
# network boundary comes from the github-review provider profile + the
# policy.yaml baked below.
#
# Build:  ./build.sh   (podman build -t ai-lab/openshell-pi-pr-review-sandbox .)
# Run:    ./run.sh [name] [provider]

ARG BASE_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest
FROM ${BASE_IMAGE}

USER root

# Install pi
RUN npm install -g @earendil-works/pi-coding-agent

# File-search binaries used by pi's tools (ripgrep + fd). Installed at build
# time because the sandbox has no egress to the hosts pi's on-demand
# downloader would use (policy.yaml grants no registry/general downloads).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ripgrep fd-find \
    && rm -rf /var/lib/apt/lists/*

# Git over https auth for github.com: point git at gh's built-in credential
# helper (`gh auth git-credential`). It reads the GITHUB_TOKEN env var at
# request time — the OpenShell credential placeholder injected by the provider
# — and the supervisor rewrites the Authorization header with the real token
# in transit for profile-declared endpoints. No secret in the image, no
# custom scripts; this is exactly the config `gh auth setup-git` writes.
# Copy sandbox network policy (baked in as the create-time default)
COPY policy.yaml /etc/openshell/policy.yaml

# Configure pi: AGENTS.md persona (PR review) + inference models.json.
# Loaded from ~/.pi/agent/ (global) by pi at startup.
COPY --chown=sandbox:sandbox agent-config/ /sandbox/.pi/agent/

USER sandbox

# Install the git credential helper config into the sandbox user's HOME.
RUN printf '[credential "https://github.com"]\n\thelper = !/usr/bin/gh auth git-credential\n[credential "gist.github.com"]\n\thelper = !/usr/bin/gh auth git-credential\n' \
    > /sandbox/.gitconfig

ENTRYPOINT ["/bin/bash"]
